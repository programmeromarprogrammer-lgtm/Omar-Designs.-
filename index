<script>

/* =========================
   BASIC FUNCTIONS
========================= */

const $ = id => document.getElementById(id);

const WA = "201018496877";

const EMAIL =
"programmer.omar.programmer@gmail.com";


/* =========================
   PAGE NAVIGATION
========================= */

function goTo(page){

document
.querySelectorAll(".page")
.forEach(p => {

p.classList.remove("active");

});

const target = $(page);

if(target){

target.classList.add("active");

}

document
.querySelectorAll(".nav-btn")
.forEach(btn => {

btn.classList.toggle(
"active",
btn.dataset.page === page
);

});

const navLinks = $("navLinks");

if(navLinks){

navLinks.classList.remove("open");

}

window.scrollTo({
top:0,
behavior:"smooth"
});

}


/* =========================
   NAV BUTTONS
========================= */

document
.querySelectorAll(".nav-btn")
.forEach(btn => {

btn.addEventListener("click", () => {

goTo(btn.dataset.page);

});

});


/* =========================
   MOBILE MENU
========================= */

$("menuBtn").addEventListener(
"click",
() => {

const nav = $("navLinks");

const open =
nav.classList.toggle("open");

$("menuBtn").setAttribute(
"aria-expanded",
open ? "true" : "false"
);

}
);


/* =========================
   THEME
========================= */

const savedTheme =
localStorage.getItem("omar-theme");

if(savedTheme === "light"){

document.body.classList.add("light");

$("themeBtn").textContent = "☀️";

}

$("themeBtn").addEventListener(
"click",
() => {

document.body.classList.toggle("light");

const light =
document.body.classList.contains("light");

localStorage.setItem(
"omar-theme",
light ? "light" : "dark"
);

$("themeBtn").textContent =
light ? "☀️" : "🌙";

}
);


/* =========================
   PROJECT MODAL
========================= */

function openProject(title,text,img){

$("modalTitle").textContent =
title;

$("modalText").textContent =
text;

$("modalImg").src =
img;

$("modalImg").alt =
title;

$("projectModal")
.classList.add("show");

document.body.style.overflow =
"hidden";

}


function closeProject(){

$("projectModal")
.classList.remove("show");

document.body.style.overflow =
"";

}


$("projectModal").addEventListener(
"click",
e => {

if(e.target.id === "projectModal"){

closeProject();

}

}
);


/* =========================
   ORDER DATA
========================= */

const packages = {

basic:{
name:"Basic",
price:1500
},

pro:{
name:"Pro",
price:3000
},

premium:{
name:"Premium",
price:5000
}

};


function getOrderData(){

const selected =
document.querySelector(
'input[name="package"]:checked'
);

const pkg =
packages[selected.value];

const addons =
[
...document.querySelectorAll(
".addon:checked"
)
];

const addonTotal =
addons.reduce(
(sum,item) =>
sum + Number(item.dataset.price),
0
);

return {

pkg,

addons,

addonTotal,

total:
pkg.price + addonTotal,

selected

};

}


/* =========================
   UPDATE PRICE
========================= */

function updateOrder(){

const d =
getOrderData();

$("orderPrice").innerHTML =
d.total.toLocaleString("en-US")
+
' <small>ج.م</small>';

$("selectedPackage").textContent =
d.pkg.name;

$("addonCount").textContent =
d.addons.length;

const percent =
Math.min(
100,
25 + d.addons.length * 15
);

$("orderProgress").style.width =
percent + "%";

$("orderPercent").textContent =
percent + "%";


document
.querySelectorAll(".package")
.forEach(p =>
p.classList.remove("active")
);

d.selected
.closest(".package")
.classList.add("active");

}


document
.querySelectorAll(
'input[name="package"], .addon'
)
.forEach(el => {

el.addEventListener(
"change",
updateOrder
);

});


/* =========================
   START ORDER
========================= */

function startOrder(type){

const radio =
document.querySelector(
`input[name="package"][value="${type}"]`
);

if(radio){

radio.checked = true;

updateOrder();

}

goTo("order");

}


/* =========================
   VALIDATE ORDER
========================= */

function validateOrder(){

const name =
$("orderName").value.trim();

const details =
$("orderDetails").value.trim();

if(!name || !details){

showToast(
"اكتب اسمك وتفاصيل المشروع أولاً."
);

return null;

}

return {

name,

email:
$("orderEmail").value.trim(),

business:
$("orderBusiness").value.trim(),

details,

...getOrderData()

};

}


/* =========================
   CREATE ORDER MESSAGE
========================= */

function orderMessage(){

const d =
validateOrder();

if(!d){

return null;

}

const addonText =
d.addons.length

?

d.addons
.map(
a =>
`${a.dataset.name} (+${Number(a.dataset.price).toLocaleString("en-US")} ج.م)`
)
.join("، ")

:

"لا توجد إضافات";


return `مرحباً Omar Designs 👋

الاسم: ${d.name}
الإيميل: ${d.email || "غير مذكور"}
اسم المشروع: ${d.business || "غير مذكور"}

الباقة: ${d.pkg.name}
سعر الباقة: ${d.pkg.price.toLocaleString("en-US")} ج.م
الإضافات: ${addonText}
السعر التقديري: ${d.total.toLocaleString("en-US")} ج.م

تفاصيل المشروع:
${d.details}

أرسل لي العرض النهائي بعد مراجعة التفاصيل.`;

}


/* =========================
   SEND WHATSAPP
========================= */

function sendWhatsApp(){

const message =
orderMessage();

if(!message){

return;

}

window.open(
`https://wa.me/${WA}?text=${encodeURIComponent(message)}`,
"_blank"
);

showToast(
"تم تجهيز رسالة الطلب على واتساب."
);

}


/* =========================
   SEND EMAIL
========================= */

function sendEmail(){

const message =
orderMessage();

if(!message){

return;

}

const business =
$("orderBusiness")
.value
.trim();

const subject =
encodeURIComponent(
`طلب عرض سعر - ${business || "مشروع جديد"}`
);

window.location.href =
`mailto:${EMAIL}?subject=${subject}&body=${encodeURIComponent(message)}`;

}


/* =========================
   TOAST
========================= */

function showToast(text){

const toast =
$("toast");

toast.textContent =
text;

toast.classList.add("show");

clearTimeout(
window.toastTimer
);

window.toastTimer =
setTimeout(
() => {

toast.classList.remove("show");

},
2800
);

}


/* =========================
   YEAR
========================= */

$("year").textContent =
new Date().getFullYear();


/* =========================
   SCROLL TOP
========================= */

$("scrollTop").addEventListener(
"click",
() => {

window.scrollTo({
top:0,
behavior:"smooth"
});

}
);


window.addEventListener(
"scroll",
() => {

$("scrollTop").style.display =
window.scrollY > 350
? "block"
: "none";

}
);


/* =========================
   PROJECT FILTERS
========================= */

document
.querySelectorAll(".filter-btn")
.forEach(button => {

button.addEventListener(
"click",
() => {

document
.querySelectorAll(".filter-btn")
.forEach(b =>
b.classList.remove("active")
);

button.classList.add("active");

const filter =
button.dataset.filter;

document
.querySelectorAll(".project-card")
.forEach(card => {

card.classList.toggle(
"is-hidden",
filter !== "all" &&
card.dataset.category !== filter
);

});

}
);

});


/* =========================
   INITIALIZE
========================= */

updateOrder();

</script>

