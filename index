<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="Omar Designs — تصميم مواقع ويب احترافية، متاجر إلكترونية، هويات بصرية وتصميمات رقمية.">
<meta name="keywords" content="Omar Designs, تصميم مواقع, تصميم جرافيك, متجر إلكتروني, هوية بصرية, مواقع مصر">
<meta name="author" content="Omar Designs">

<meta name="theme-color" content="#07111f">

<meta property="og:title" content="Omar Designs | Web & Graphic Design">
<meta property="og:description" content="حوّل فكرتك إلى موقع احترافي وهوية رقمية مميزة.">
<meta property="og:type" content="website">

<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E💎%3C/text%3E%3C/svg%3E">

<title>Omar Designs | Web & Graphic Design</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');

:root{
--bg:#080b16;
--bg2:#10162a;
--card:rgba(18,25,45,.76);
--solid:#12192d;
--text:#f7f9ff;
--muted:#aab4cc;
--primary:#00c8ff;
--primary2:#5865ff;
--accent:#ffc857;
--success:#32d583;
--border:rgba(255,255,255,.10);
--shadow:0 20px 60px rgba(0,0,0,.28);
--radius:24px;
}

body.light{
--bg:#f4f7fb;
--bg2:#e9eef8;
--card:rgba(255,255,255,.86);
--solid:#fff;
--text:#101525;
--muted:#5f6b82;
--border:rgba(16,21,37,.10);
--shadow:0 18px 50px rgba(31,42,68,.12);
}

*{
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{
margin:0;
min-height:100vh;
font-family:'Cairo',Arial,sans-serif;
color:var(--text);

background:
radial-gradient(
circle at 15% 10%,
rgba(0,200,255,.13),
transparent 28%
),
radial-gradient(
circle at 85% 20%,
rgba(88,101,255,.15),
transparent 30%
),
linear-gradient(
135deg,
var(--bg),
var(--bg2)
);

transition:.35s;
}

button,
input,
textarea{
font:inherit;
}

button{
cursor:pointer;
}

a{
color:inherit;
text-decoration:none;
}

.bg-orb{
position:fixed;
width:280px;
height:280px;
border-radius:50%;
filter:blur(80px);
opacity:.13;
pointer-events:none;
z-index:-1;
}

.orb-1{
background:var(--primary);
top:12%;
right:-100px;
}

.orb-2{
background:var(--primary2);
bottom:5%;
left:-100px;
}

/* NAVBAR */

.navbar{
position:sticky;
top:0;
z-index:1000;

display:flex;
align-items:center;
justify-content:center;

gap:7px;
flex-wrap:wrap;

padding:11px 16px;

background:rgba(8,11,22,.78);
border-bottom:1px solid var(--border);

backdrop-filter:blur(18px);
}

body.light .navbar{
background:rgba(244,247,251,.82);
}

.brand{
margin-left:10px;

font-weight:900;
font-size:18px;

background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

-webkit-background-clip:text;
background-clip:text;
color:transparent;
}

.nav-btn,
.theme-btn,
.menu-btn{
border:1px solid var(--border);
background:transparent;
color:var(--text);

padding:8px 12px;
border-radius:999px;

font-weight:800;
transition:.25s;
}

.nav-btn:hover,
.theme-btn:hover,
.menu-btn:hover{
transform:translateY(-2px);
border-color:var(--primary);
}

.nav-btn.active{
background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

color:#fff;
border-color:transparent;

box-shadow:
0 8px 25px rgba(0,200,255,.22);
}

.menu-btn{
display:none;
font-size:20px;
padding:7px 11px;
}

.container{
width:min(1120px,92%);
margin:auto;
}

.page{
display:none;
animation:pageIn .4s ease;
}

.page.active{
display:block;
}

@keyframes pageIn{
from{
opacity:0;
transform:translateY(14px);
}

to{
opacity:1;
transform:none;
}
}

/* HERO */

.hero{
min-height:70vh;

display:grid;
grid-template-columns:1.15fr .85fr;

gap:30px;
align-items:center;

padding:70px 0 45px;
}

.eyebrow{
display:inline-flex;
gap:8px;
align-items:center;

padding:7px 13px;

border:1px solid rgba(0,200,255,.25);
border-radius:999px;

background:rgba(0,200,255,.08);

color:var(--primary);

font-weight:900;
font-size:12px;

letter-spacing:1.5px;
}

h1{
font-size:clamp(2.3rem,6vw,4.8rem);
line-height:1.08;
margin:18px 0 14px;
}

.gradient-text{
background:
linear-gradient(
90deg,
var(--primary),
#fff,
var(--primary2)
);

-webkit-background-clip:text;
background-clip:text;
color:transparent;
}

.hero p{
font-size:1.08rem;
line-height:1.9;

color:var(--muted);

max-width:680px;
}

.actions{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:24px;
}

.btn{
border:0;
border-radius:14px;

padding:12px 18px;

font-weight:800;

background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

color:#fff;

box-shadow:
0 10px 28px rgba(0,200,255,.20);

transition:.25s;

display:inline-flex;
align-items:center;
justify-content:center;
gap:6px;
}

.btn:hover{
transform:translateY(-3px);

box-shadow:
0 15px 35px rgba(0,200,255,.28);
}

.btn.secondary{
background:transparent;
border:1px solid var(--border);
box-shadow:none;
color:var(--text);
}

.btn.whatsapp{
background:#25d366;
box-shadow:
0 10px 28px rgba(37,211,102,.20);
}

.btn.email{
background:transparent;
border:1px solid rgba(0,200,255,.35);
color:var(--primary);
box-shadow:none;
}

.btn.small{
padding:9px 13px;
font-size:13px;
}

/* HERO CARD */

.hero-card{
position:relative;

min-height:380px;

border:1px solid var(--border);
border-radius:32px;

background:var(--card);

backdrop-filter:blur(18px);

box-shadow:var(--shadow);

overflow:hidden;

padding:26px;

display:flex;
flex-direction:column;
justify-content:space-between;
}

.hero-card::before{
content:"";

position:absolute;

inset:-80px auto auto -80px;

width:220px;
height:220px;

border-radius:50%;

background:var(--primary);

filter:blur(70px);

opacity:.18;
}

.mockup{
border:1px solid var(--border);
border-radius:20px;

padding:15px;

background:rgba(255,255,255,.04);
}

.mock-top{
display:flex;
gap:6px;
margin-bottom:14px;
}

.dot{
width:9px;
height:9px;

border-radius:50%;

background:var(--muted);

opacity:.7;
}

.mock-line{
height:12px;

border-radius:8px;

background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

margin:10px 0;
}

.mock-line.short{
width:55%;
}

.mock-line.tiny{
width:30%;
}

.mock-grid{
display:grid;
grid-template-columns:repeat(3,1fr);

gap:8px;

margin-top:14px;
}

.mock-box{
height:90px;

border-radius:12px;

background:rgba(255,255,255,.07);

border:1px solid var(--border);
}

.floating-badge{
position:absolute;

bottom:24px;
left:24px;

padding:10px 14px;

border-radius:14px;

background:var(--solid);

border:1px solid var(--border);

box-shadow:var(--shadow);

font-weight:800;
}

/* GENERAL */

.section-title{
text-align:center;
margin:35px 0 25px;
}

.section-title h2{
font-size:2rem;
margin:0 0 7px;
}

.section-title p{
color:var(--muted);
margin:0;
}

.card{
background:var(--card);

border:1px solid var(--border);

border-radius:var(--radius);

padding:24px;

box-shadow:var(--shadow);

backdrop-filter:blur(14px);

transition:.25s;
}

.card:hover{
border-color:rgba(0,200,255,.28);
transform:translateY(-2px);
}

/* PROJECTS */

.projects-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.project-card{
overflow:hidden;
padding:0;
}

.project-img{
width:100%;
height:190px;

object-fit:cover;

display:block;

background:var(--bg2);
}

.project-body{
padding:20px;
}

.project-body h3{
margin:0 0 7px;
}

.project-body p{
color:var(--muted);
line-height:1.8;
}

.tags{
display:flex;
gap:7px;
flex-wrap:wrap;
margin:12px 0;
}

.tag{
font-size:12px;

padding:5px 9px;

border-radius:999px;

background:rgba(0,200,255,.09);

color:var(--primary);

border:1px solid rgba(0,200,255,.16);
}

.filters{
display:flex;
flex-wrap:wrap;
gap:9px;
margin:0 0 18px;
}

.filter-btn{
border:1px solid var(--border);

background:rgba(255,255,255,.035);

color:var(--text);

padding:9px 15px;

border-radius:999px;

font-weight:800;

transition:.2s;
}

.filter-btn:hover,
.filter-btn.active{
border-color:var(--primary);

color:var(--primary);

background:rgba(0,200,255,.08);
}

.is-hidden{
display:none!important;
}

/* ORDER */

.contact-grid{
display:grid;
grid-template-columns:1fr .75fr;
gap:18px;
}

.input{
width:100%;

padding:13px 15px;

border:1px solid var(--border);

border-radius:14px;

background:rgba(255,255,255,.05);

color:var(--text);

outline:none;

margin:8px 0;
}

.input:focus{
border-color:var(--primary);

box-shadow:
0 0 0 3px rgba(0,200,255,.10);
}

textarea.input{
resize:vertical;
min-height:130px;
}

.package-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
}

.package{
position:relative;

display:block;

padding:18px;

border:1px solid var(--border);

border-radius:18px;

background:rgba(255,255,255,.035);

cursor:pointer;

transition:.25s;
}

.package:hover,
.package.active,
.package:has(input:checked){
transform:translateY(-3px);

border-color:var(--primary);

box-shadow:
0 0 0 2px rgba(0,200,255,.12);

background:rgba(0,200,255,.06);
}

.package input{
position:absolute;
opacity:0;
}

.package-name{
display:block;

font-weight:900;
font-size:20px;

margin-bottom:8px;
}

.package strong{
display:block;

font-size:21px;

color:var(--primary);

margin-bottom:5px;
}

.package small{
color:var(--muted);
}

.popular-badge{
position:absolute;

top:-10px;
right:12px;

padding:4px 9px;

border-radius:999px;

background:var(--accent);

color:#15110a;

font-size:11px;

font-weight:900;
}

.addons{
display:grid;
gap:9px;
}

.addons label{
display:flex;

align-items:center;

gap:10px;

padding:12px;

border:1px solid var(--border);

border-radius:13px;

background:rgba(255,255,255,.025);

cursor:pointer;
}

.addons input{
width:18px;
height:18px;

accent-color:var(--primary);
}

.addons b{
margin-right:auto;
color:var(--primary);
}

.summary-top,
.summary-line{
display:flex;

justify-content:space-between;

gap:10px;
}

.summary-top{
font-weight:800;
color:var(--muted);
}

.price{
font-size:46px;

font-weight:900;

margin:18px 0 25px;

background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

-webkit-background-clip:text;
background-clip:text;

color:transparent;
}

.price small{
font-size:17px;
}

.summary-line{
padding:13px 0;

border-bottom:1px solid var(--border);
}

.summary-line b{
color:var(--primary);
}

.summary-note{
margin-top:20px;

padding:13px;

border-radius:14px;

background:rgba(255,200,87,.08);

border:1px solid rgba(255,200,87,.2);

color:var(--muted);

line-height:1.8;

font-size:13px;
}

.progress-wrap{
margin-top:18px;
}

.progress-track{
height:12px;

background:rgba(255,255,255,.08);

border-radius:99px;

overflow:hidden;
}

.progress-fill{
height:100%;
width:0;

background:
linear-gradient(
90deg,
var(--success),
var(--primary)
);

transition:.4s;
}

/* CARDS */

.skill-head{
display:flex;

justify-content:space-between;

margin-bottom:6px;

font-weight:700;
}

.cards-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:16px;
}

.skills-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:16px;
}

.skill-card{
padding:20px;
}

.skill-icon{
font-size:30px;
margin-bottom:12px;
}

.skill-card p,
.review p{
color:var(--muted);

line-height:1.8;

margin:12px 0 0;
}

.step{
font-size:14px;

font-weight:900;

color:var(--primary);

margin-bottom:12px;
}

/* FAQ */

.faq-list{
display:grid;
gap:12px;
}

.faq-list summary{
cursor:pointer;

font-weight:900;

list-style:none;
}

.faq-list summary::-webkit-details-marker{
display:none;
}

.faq-list summary:after{
content:"+";

float:left;

color:var(--primary);

font-size:22px;
}

.faq-list details[open] summary:after{
content:"−";
}

/* ABOUT */

.about-grid{
display:grid;

grid-template-columns:.8fr 1.2fr;

gap:18px;
}

.profile{
width:130px;
height:130px;

border-radius:50%;

margin:0 auto 16px;

display:block;

object-fit:cover;

border:3px solid var(--primary);

box-shadow:
0 0 35px rgba(0,200,255,.25);
}

.center{
text-align:center;
}

.skills{
display:grid;
gap:14px;
}

.bar{
height:9px;

background:rgba(255,255,255,.08);

border-radius:99px;

overflow:hidden;
}

.bar i{
display:block;

height:100%;

width:var(--w);

background:
linear-gradient(
90deg,
var(--primary),
var(--primary2)
);

border-radius:inherit;
}

/* STATS */

.stats{
display:grid;

grid-template-columns:repeat(4,1fr);

gap:12px;

margin:20px 0;
}

.stat{
text-align:center;
}

.stat strong{
display:block;

font-size:30px;

color:var(--primary);
}

.stat span{
color:var(--muted);

font-size:13px;
}

/* WHY */

.why-grid{
display:grid;

grid-template-columns:repeat(3,1fr);

gap:14px;
}

.why-icon{
font-size:28px;
}

/* CTA */

.cta-card{
text-align:center;

padding:42px 24px;
}

.cta-card h2{
font-size:clamp(28px,4vw,48px);

margin:10px 0;
}

.cta-card p{
color:var(--muted);

max-width:650px;

margin:0 auto 22px;

line-height:1.9;
}

.cta-actions{
display:flex;

justify-content:center;

gap:10px;

flex-wrap:wrap;
}

/* FOOTER */

footer{
text-align:center;

color:var(--muted);

padding:45px 0 30px;

border-top:1px solid var(--border);

margin-top:50px;
}

/* MODAL */

.modal{
position:fixed;

inset:0;

z-index:2000;

display:none;

align-items:center;
justify-content:center;

padding:20px;

background:rgba(0,0,0,.68);

backdrop-filter:blur(7px);
}

.modal.show{
display:flex;
}

.modal-card{
width:min(650px,100%);

max-height:85vh;

overflow:auto;

background:var(--solid);

border:1px solid var(--border);

border-radius:24px;

padding:24px;

box-shadow:var(--shadow);
}

.modal-img{
width:100%;

max-height:280px;

object-fit:cover;

border-radius:16px;

margin:12px 0 16px;
}

.modal-head{
display:flex;

align-items:center;

justify-content:space-between;

gap:10px;
}

.close{
border:0;

background:transparent;

color:var(--text);

font-size:25px;
}

.modal-actions{
display:flex;

gap:8px;

flex-wrap:wrap;
}

/* FLOAT BUTTONS */

#whatsappFloat{
position:fixed;

right:20px;
bottom:20px;

width:52px;
height:52px;

border-radius:50%;

display:flex;

align-items:center;
justify-content:center;

background:#25d366;

color:#fff;

font-size:25px;

z-index:900;

box-shadow:
0 10px 28px rgba(37,211,102,.28);

transition:.25s;
}

#whatsappFloat:hover{
transform:translateY(-4px) scale(1.06);
}

#scrollTop{
position:fixed;

left:20px;
bottom:20px;

width:48px;
height:48px;

border:0;

border-radius:50%;

display:none;

background:
linear-gradient(
135deg,
var(--primary),
var(--primary2)
);

color:#fff;

font-size:22px;

z-index:900;
}

.toast{
position:fixed;

left:50%;
bottom:82px;

transform:translate(-50%,20px);

opacity:0;

pointer-events:none;

z-index:3000;

background:var(--solid);

border:1px solid var(--border);

padding:12px 18px;

border-radius:14px;

box-shadow:var(--shadow);

transition:.3s;
}

.toast.show{
opacity:1;

transform:translate(-50%,0);
}

/* MOBILE */

@media(max-width:850px){

.hero,
.about-grid,
.contact-grid{
grid-template-columns:1fr;
}

.package-grid,
.skills-grid{
grid-template-columns:1fr;
}

.hero{
padding-top:45px;
}

.hero-card{
min-height:300px;
}

.projects-grid{
grid-template-columns:repeat(2,1fr);
}

.stats{
grid-template-columns:repeat(2,1fr);
}

.why-grid{
grid-template-columns:1fr;
}

}

@media(max-width:680px){

.navbar{
justify-content:space-between;
}

.brand{
margin:0;
}

.menu-btn{
display:block;
}

.nav-links{
display:none;

width:100%;

grid-template-columns:repeat(2,1fr);

gap:6px;
}

.nav-links.open{
display:grid;
}

.nav-btn{
font-size:12px;
padding:8px 7px;
}

.theme-btn{
padding:7px 10px;
}

}

@media(max-width:580px){

.projects-grid,
.cards-grid{
grid-template-columns:1fr;
}

.container{
width:94%;
}

.hero{
min-height:auto;
}

.hero-card{
min-height:280px;
}

.mock-box{
height:65px;
}

.floating-badge{
bottom:15px;
left:15px;
}

.actions .btn{
width:100%;
}

.stats{
grid-template-columns:repeat(2,1fr);
}

h1{
font-size:clamp(2.2rem,12vw,3.5rem);
}

}

@media(prefers-reduced-motion:reduce){

*,
*::before,
*::after{
scroll-behavior:auto!important;
animation:none!important;
transition:none!important;
}

}

</style>
</head>

<body>

<div class="bg-orb orb-1"></div>
<div class="bg-orb orb-2"></div>

<nav class="navbar" aria-label="التنقل الرئيسي">

<div class="brand">
OMAR DESIGNS
</div>

<button
class="menu-btn"
id="menuBtn"
aria-label="فتح القائمة"
aria-expanded="false">
☰
</button>

<div class="nav-links" id="navLinks">

<button class="nav-btn active" data-page="home">
🏠 الرئيسية
</button>

<button class="nav-btn" data-page="projects">
💼 أعمالي
</button>

<button class="nav-btn" data-page="services">
🚀 الخدمات
</button>

<button class="nav-btn" data-page="order">
🛒 اطلب الآن
</button>

<button class="nav-btn" data-page="faq">
❓ FAQ
</button>

<button class="nav-btn" data-page="reviews">
⭐ الآراء
</button>

<button class="nav-btn" data-page="skills">
⚡ المهارات
</button>

<button class="nav-btn" data-page="process">
🚀 طريقة العمل
</button>

<button class="nav-btn" data-page="about">
👤 عني
</button>

</div>

<button
class="theme-btn"
id="themeBtn"
aria-label="تغيير المظهر">
🌙
</button>

</nav>

<main class="container">

<section id="home" class="page active">

<div class="hero">

<div>

<span class="eyebrow">
⚡ متاح لمشاريع جديدة • Web & Graphic Design
</span>

<h1>
